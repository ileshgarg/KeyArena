# KeyArena Environment Configuration Example

# Port for Next.js web application (default: 3000)
PORT=3000

# Port for WebSocket multiplayer server (default: 8080)
WS_PORT=8080

# Public WebSocket URL for clients (optional in local dev, set if hosted on custom domain / WSS)
# Example: wss://multiplayer.keyarena.app or wss://api.yourdomain.com
NEXT_PUBLIC_WS_URL=

# Node Environment
NODE_ENV=production
